# 기본: 텍스트는 저장소에 LF 로 저장한다
* text=auto eol=lf

# Windows 전용 스크립트는 작업 사본에서 CRLF 여야 한다
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Linux 에서 실행되는 것은 반드시 LF (CRLF 면 bad interpreter 로 죽는다)
mvnw       text eol=lf
*.sh       text eol=lf
Dockerfile text eol=lf

# 이진 파일은 변환하지 않는다
*.jar   binary
*.war   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
