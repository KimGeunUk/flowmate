<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowmate.attendance.mapper.LeaveBalanceMapper">

    <sql id="balanceColumns">
        emp_id, year, granted_days, used_days, updated_at
    </sql>

    <select id="findByEmpIdAndYear" resultType="LeaveBalance">
        SELECT <include refid="balanceColumns"/>
          FROM leave_balance
         WHERE emp_id = #{empId} AND year = #{year}
    </select>

    <!--
      FOR UPDATE 로 행을 잠근다 (계획서 4 D3).
      같은 사원의 연차 신청서 2건이 동시에 승인되면, 잠그지 않을 경우 둘 다
      같은 used_days 를 읽고 둘 다 같은 값을 써서 하루가 사라진다(갱신 분실).
      잠금 순서는 approval_doc → leave_balance 로 고정한다 — approve() 가 먼저
      문서를 잠그고 그 안에서 이 조회를 부르므로 교착이 없다.
    -->
    <select id="findForUpdate" resultType="LeaveBalance">
        SELECT <include refid="balanceColumns"/>
          FROM leave_balance
         WHERE emp_id = #{empId} AND year = #{year}
         FOR UPDATE
    </select>

    <update id="updateUsedDays">
        UPDATE leave_balance
           SET used_days  = #{usedDays},
               updated_at = CURRENT_TIMESTAMP
         WHERE emp_id = #{empId} AND year = #{year}
    </update>

</mapper>
