<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowmate.ai.mapper.PromptMapper">

    <!-- 없으면 null - DatabasePromptRepository 가 FilePromptRepository 와 같은 계약대로 IllegalArgumentException 으로 바꾼다 -->
    <select id="findBody" resultType="string">
        SELECT body
          FROM ai_prompt
         WHERE feature = #{feature}
           AND version = #{version}
    </select>

</mapper>
